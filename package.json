{
  "name": "bk-plugin-explain-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Beekeeper Studio plugin that visualizes query execution plans",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "harness": "vite --config vite.harness.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@beekeeperstudio/plugin": "^1.8.0",
    "d3-hierarchy": "^3.1.2",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@beekeeperstudio/vite-plugin": "^1.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6",
    "happy-dom": "^21.0.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vite": "^7",
    "vitest": "^5",
    "vue-tsc": "^3"
  }
}
